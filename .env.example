# ============================================================================
#  PODCAST STUDIO - keys file
#  1. Copy this file to ".env"   (Windows:  copy .env.example .env)
#  2. Paste each key after the "=" of its line. No quotes, no spaces.
#  3. Save. That is all: run  python -m podcast_studio.cli doctor
#  NEVER share or commit .env.
#  Several keys for one line? Separate them with commas:  KEY=abc123...,def456...
#  When one key runs out of credit the next one is used automatically.
# ============================================================================

# --- Language model (writes the script) -------------------------------------
# Create one at https://openrouter.ai/keys  (starts with sk-or-)
OPENROUTER_API_KEY=

# --- Bodhan (console.bodhan.ai -> API keys -> "Create key", pick the model) ---
# Key whose model is  indic-speak   (the voices)  -- REQUIRED
BODHAN_TTS_API_KEY=
# Key whose model is  indic-translate  -- optional, only for the "translate" writing mode
BODHAN_MT_API_KEY=
# Key whose model is  indic-ocr  -- optional, reserved for later (scanned PDFs use the OpenRouter vision model today)
BODHAN_OCR_API_KEY=
# (Old setting: ONE Bodhan key that has every model. Still works if the TTS/MT lines above are empty.)
# BODHAN_API_KEY=

# --- Models (OpenRouter names; find them with:  python -m podcast_studio.cli models claude) ---
# LLM_MODEL_WRITER=anthropic/claude-sonnet-4.5
# LLM_MODEL_PLANNER=anthropic/claude-sonnet-4.5
# LLM_MODEL_CHECKER=google/gemini-2.5-flash
# LLM_MODEL_VISION=google/gemini-2.5-flash
# LLM_FALLBACK_MODELS=google/gemini-2.5-flash,openai/gpt-4o-mini

# --- Other ---
# TTS_CONCURRENCY=3
# DATA_DIR=data
# TUNING_FILE=tuning.json

# 1 = run fully offline with fake beep voices (demo, uses no credits)
MOCK_APIS=0
