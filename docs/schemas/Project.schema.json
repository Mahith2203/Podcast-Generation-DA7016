{
  "$defs": {
    "ChapterMark": {
      "description": "A chapter marker in the final audio: segment title and start time in seconds.",
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "number"
        }
      },
      "required": [
        "index",
        "title",
        "start"
      ],
      "title": "ChapterMark",
      "type": "object"
    },
    "CheckReport": {
      "description": "Result of checking one segment: verdict, issues, missing key points and whether it still needs a human look after\nthe repair attempts.",
      "properties": {
        "verdict": {
          "default": "unchecked",
          "enum": [
            "pass",
            "revise",
            "unchecked"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "missing_points": {
          "items": {
            "type": "string"
          },
          "title": "Missing Points",
          "type": "array"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "attempts": {
          "default": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        }
      },
      "title": "CheckReport",
      "type": "object"
    },
    "Figure": {
      "description": "A picture found in the chapter PDF (shown in the video with its original caption, never re-captioned).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "width": {
          "default": 0,
