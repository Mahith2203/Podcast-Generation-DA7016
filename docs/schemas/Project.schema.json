            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Unit"
        },
        "suggested_fix": {
          "default": "",
          "title": "Suggested Fix",
          "type": "string"
        },
        "source": {
          "default": "llm",
          "enum": [
            "llm",
            "rule"
          ],
