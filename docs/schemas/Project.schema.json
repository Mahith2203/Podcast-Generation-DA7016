    "HostCfg": {
      "description": "One host: display name, voice and the grammatical gender implied by the voice.",
      "properties": {
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "voice": {
          "title": "Voice",
          "type": "string"
        },
        "gender": {
          "default": "female",
          "enum": [
            "female",
            "male"
          ],
          "title": "Gender",
          "type": "string"
        }
      },
      "required": [
        "name",
        "voice"
      ],
      "title": "HostCfg",
      "type": "object"
    },
    "Issue": {
      "description": "One problem found by a check, with its severity, the line it concerns and a suggested fix.",
      "properties": {
        "turn": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn"
        },
        "severity": {
          "default": "minor",
          "enum": [
            "major",
            "minor"
          ],
