    "ProjectSettings": {
      "description": "Everything chosen when an episode is created: language, writing mode, length, hosts, fact-check on or off,\ndelivery styles, and optional instructions. Out-of-range values are clamped.",
      "properties": {
        "language": {
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "writing_mode": {
          "default": "direct",
          "enum": [
            "direct",
            "translate"
          ],
          "title": "Writing Mode",
          "type": "string"
        },
        "polish_translation": {
          "default": false,
          "title": "Polish Translation",
          "type": "boolean"
        },
        "audience": {
          "default": "school students (Classes 6-12)",
          "title": "Audience",
          "type": "string"
        },
        "minutes": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minutes"
