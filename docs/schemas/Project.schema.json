          "type": "integer"
        },
        "built_at": {
          "default": "",
          "title": "Built At",
          "type": "string"
        },
        "audio_built_at": {
          "default": "",
          "title": "Audio Built At",
          "type": "string"
        },
        "stale": {
          "default": false,
