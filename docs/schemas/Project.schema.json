            "type": "string"
          },
          "title": "Allowed Styles",
          "type": "array"
        },
        "jingle": {
          "default": true,
          "title": "Jingle",
          "type": "boolean"
        },
        "auto_voice": {
          "default": true,
          "title": "Auto Voice",
          "type": "boolean"
        },
        "make_video": {
          "default": false,
          "title": "Make Video",
          "type": "boolean"
        },
        "extra_instructions": {
          "default": "",
          "title": "Extra Instructions",
          "type": "string"
        },
        "writer_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
