          "type": "integer"
        },
        "height": {
          "default": 0,
          "title": "Height",
          "type": "integer"
        },
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        },
        "near_text": {
          "default": "",
          "title": "Near Text",
          "type": "string"
        },
        "unit_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Id"
        }
      },
      "required": [
        "id",
        "page",
        "file"
      ],
      "title": "Figure",
      "type": "object"
    },
